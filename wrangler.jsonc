{
  // Hospedagem do ElectoMaps em Workers + Static Assets.
  //
  // O site e asset estatico: requisicao a asset e gratuita e ilimitada. O unico
  // codigo de Worker (worker/apuracao.js) atende so /dados/*, os snapshots da
  // apuracao ao vivo, que o plantao grava no R2 -- ver run_worker_first abaixo.
  // Cada chamada a ele conta no plano Workers Paid (10 mi/mes incluidas).
  //
  // Medido em 17/09/2026: 4.429 arquivos, 1,90 GB, nenhum acima de 25 MiB.
  // Limites do plano Free: 20.000 arquivos por versao, 25 MiB por arquivo.
  //
  // O que sobe e governado por .assetsignore, NAO por .gitignore -- o wrangler
  // ignora o .gitignore. Sem aquele arquivo o deploy tenta subir 5,2 GB e falha
  // nos zips de 107 MB de "Resultados 1998".
  "$schema": "node_modules/wrangler/config-schema.json",
  // Account: ha dois accounts sob o mesmo login -- o "electomaps" e o
  // pessoal. Fixado aqui para o wrangler nao ter o que perguntar, e para
  // nao existir a chance de publicar no account errado por engano.
  // ID de conta nao e credencial: sozinho nao da acesso a nada.
  "account_id": "fb3deb1186d822071fe34aabf61f6672",

  "name": "electomaps",
  "main": "worker/apuracao.js",
  "compatibility_date": "2026-09-17",

  // URL de teste em workers.dev desligada em 17/09/2026, ate o dominio
  // entrar no ar. Enquanto o site so existia em
  // electomaps.electomaps.workers.dev, ele estava publico e indexavel
  // antes do lancamento -- e nenhuma regra de seguranca da zona alcanca
  // um hostname workers.dev. Voltar para true republica a URL de teste.
  "workers_dev": false,

  // Dominio proprio, conectado em 18/09/2026. Custom Domain cria o registro
  // de DNS na zona e aponta o hostname para este Worker -- e o que faz o site
  // existir publicamente. O www serve o mesmo site em vez de redirecionar para
  // o apex: redirecionamento e regra de zona, que o token do wrangler nao
  // alcanca (403). Trocar por um redirect no painel quando houver calma.
  "routes": [
    { "pattern": "electomaps.com.br", "custom_domain": true },
    { "pattern": "www.electomaps.com.br", "custom_domain": true }
  ],

  "assets": {
    // O site e servido da raiz do repositorio: os .html ficam ao lado do
    // resultados_geo/ que eles buscam.
    "directory": "./",

    // "404-page" = serve o 404.html da raiz, com a identidade do site, em vez
    // do 404 pelado da Cloudflare. A pagina foi criada em 17/09/2026; as
    // chaves de traducao dela vivem em js/i18n.js (meta.404.*, e404.*).
    "not_found_handling": "404-page",

    // So os snapshots da apuracao passam pelo Worker. Todo o resto e servido
    // direto como asset, sem invoca-lo (e sem custo); o que nao existir cai
    // no Worker, que devolve ao ASSETS, e o 404-page acima continua valendo.
    "binding": "ASSETS",
    "run_worker_first": ["/dados/*"]
  },

  // Onde o plantao grava os snapshots. O R2 precisa estar ativado na conta e o
  // bucket criado antes do deploy:  npx wrangler r2 bucket create electomaps-apuracao
  // A chave do plantao e segredo, nunca arquivo:  npx wrangler secret put CHAVE_PLANTAO
  "r2_buckets": [
    { "binding": "DADOS", "bucket_name": "electomaps-apuracao" }
  ]
}
